# AWS (required for Cognito + DynamoDB; SNS optional locally)
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Cognito (create in Terraform or AWS Console)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# DynamoDB table names (Terraform will create these)
FILES_TABLE=fluxon-files
NOTIFICATIONS_TABLE=fluxon-notifications

# SNS (optional for local Docker; required on AWS)
SNS_TOPIC_ARN=

# Postgres (local Docker only; on AWS use RDS endpoint in DATABASE_URL)
POSTGRES_USER=app
POSTGRES_PASSWORD=app

# MinIO = local S3 (Docker only). On AWS set S3_BUCKET instead.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=media

# AWS production: set S3_BUCKET and leave MinIO vars empty
# S3_BUCKET=fluxon-media-bucket

INTERNAL_WEBHOOK_SECRET=internal-secret
MAX_UPLOAD_MB=512
VITE_API_URL=http://localhost:8080
